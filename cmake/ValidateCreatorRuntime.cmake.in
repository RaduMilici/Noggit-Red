set(runtime "@CREATOR_RUNTIME_BUNDLE@")
if(EXISTS "${runtime}/game-data.json")
  file(READ "${runtime}/game-data.json" manifest)
  string(JSON format ERROR_VARIABLE error GET "${manifest}" format)
  string(JSON base_url ERROR_VARIABLE url_error GET "${manifest}" baseUrl)
  string(JSON count ERROR_VARIABLE files_error LENGTH "${manifest}" files)
  if(error OR url_error OR files_error OR NOT format EQUAL 1 OR NOT count GREATER 0 OR NOT base_url MATCHES "^https://.+/$")
    message(FATAL_ERROR "Invalid Creator game-data download manifest")
  endif()
else()
foreach(pattern dbc/*.dbc maps/*.map vmaps/*.vmtree vmaps/*.vmtile vmaps/*.vmo mmaps/*.mmap mmaps/*.mmtile)
  file(GLOB files "${runtime}/mangosd/data/${pattern}")
  set(found FALSE)
  foreach(file IN LISTS files)
    if(NOT IS_DIRECTORY "${file}")
      file(SIZE "${file}" size)
      if(size GREATER 0)
        set(found TRUE)
        break()
      endif()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Incomplete Creator game data: ${pattern}. Prepare a complete runtime with --data before packaging.")
  endif()
endforeach()
endif()
set(required OpenSSH/ssh@CMAKE_EXECUTABLE_SUFFIX@ OpenSSH/ssh-keyscan@CMAKE_EXECUTABLE_SUFFIX@)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
  list(APPEND required Wine/bin/wine Wine/bin/wineserver)
endif()
foreach(file IN LISTS required)
  if(NOT EXISTS "${runtime}/${file}" OR IS_DIRECTORY "${runtime}/${file}")
    message(FATAL_ERROR "Incomplete Creator runtime: ${file}. Rerun prepare_runtime.py with the portable tools.")
  endif()
endforeach()
